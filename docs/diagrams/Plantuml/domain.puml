@startuml

allow_mixing

skinparam {
    LineType ortho
}

actor "Nurse" as n

object "Homebase" as HB
object Car {
    Battery
    .. Buttons ..
    "Power-button"
    "Action-button"
    .. Indicators ..
    "Red LED"
    "Green LED"
    .. Modes ..
    "Idle mode"
    "Shutdown mode"
}

object UI {
    Instructions
    "Navigation options"
    Confirmation
}

object "Locations" as Loc {
    Coordinates
}
object Route


object Server {
    log
}


actor "Dispensary Nurse" as dn

Car -u-> HB : Starts\nfrom
n -r-> Car : Operates

Car -r-> Route : Calculates/\nFollows
Route -d-> Loc : Consists of

Car <-d- dn : Operates
dn -r-> Loc : Selects
UI -r-> Loc : Displays

dn -d-> UI : Uses
Server <-r-> Car : Requests/\nResponds
(Server, Car) . Loc
UI -r-> Server : Sends
(UI, Server) . Loc



@enduml