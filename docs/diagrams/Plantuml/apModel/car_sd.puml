@startuml

mainframe **SD** Car Control Diagram
hide footbox

actor "Nurse" as n
actor "Dispensary nurse" as dn
participant "MotorController" as mc
participant "pid_left_" as pl <<PID>>
participant "pid_right_" as pr <<PID>>
participant "Astar" as a
participant "DR" as dr
participant "pwm_left_" as rpl <<RPi_pwm>>
participant "pwm_right_" as rpr <<RPi_pwm>>
participant "encoder_left_" as encl <<Encoder>>
participant "encoder_right_" as encr <<Encoder>>
participant "main" as m
participant "HttpHandler" as http
actor "Server" as s



' constructors
m  ->> mc : MotorController()
mc ->> rpl : RPi_pwm()
mc ->> rpr : RPi_pwm()
mc ->> encl : Encoder()
mc ->> encr : Encoder()
mc ->> pr : PID()
mc ->> pl : PID()

' initialisation
mc ->> rpl : start()
mc ->> rpr : start()
mc ->> encl : init_encoder()
mc ->> encr : init_encoder()
mc ->> encl : start_thread()
mc ->> encr : start_thread()

m ->> m : usleep(1000000)
m ->> dr : DR()
m ->> m : init_button(int ACTIVITY_BUTTON_PIN)
m -> m : init_green_led() : gpiod_line*
m ->> m : gpiod_line_set_value(g_led_line, 0) : void
m ->> m : monitor_act_btn() : void

loop true
    loop !act_btn_pressed.load()
        dn ->> m : press activity button
    end
    m -> http : get_route(httplib::Result* res) : void
    http -> s : GET
    alt Success (200 OK)
    http <<-- s : 200 OK

        m -> a : calculate_path(Route) : std::vector<std::vector<Point>>
        a -->> m : paths
        loop for each path in paths
            m ->> m : gpiod_line_set_value(g_led_line, 1) : void
            loop !act_btn_released.load()
                n ->> m : press activity button
            end
            m ->> m : gpiod_line_set_value(g_led_line, 0) : void
            loop for each point in path
                m -> dr : calc_route(int, int) : point<double>
                dr -->> m : degrees, distance
                m -> mc : turn(double degrees)
                m -> mc : drive_distance(double distance)
            end
        end
    else Failure (!200 OK)
    http <<-- s : 404 NOT FOUND
        loop seconds != 5
            m ->> m : gpiod_line_set_value(g_led_line, 1) : void
            m ->> m : sleep_for(std::chrono::milliseconds(500)) : void
            m ->> m : gpiod_line_set_value(g_led_line, 0) : void
            m ->> m : sleep_for(std::chrono::milliseconds(500)) : void
        end
    end
end    

@enduml