{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Render pdf",
            "command": "pandoc",
            "args": [
                "${relativeFile}",
                "--pdf-engine=pdflatex",
                "-V",
                "geometry:margin=0.8in",
                "--table-caption-position=below",
                "--figure-caption-position=below",
                "--resource-path=.${/}docs${/}${fileBasenameNoExtension}",
                "-M link-citations=true",
                "--citeproc",
                "--bibliography=./docs/report/bibliography.bib",
                "--csl=ieee.csl",
                "-o",
                ".${/}${relativeFileDirname}${/}${fileBasenameNoExtension}.pdf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}