{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Render pdf",
            "command": "pandoc",
            "args": [
                "${relativeFile}",
                "--resource-path=.${/}docs${/}${fileBasenameNoExtension}",
                "--metadata-file=./defaults.YAML",
                "--citeproc",
                "--bibliography=./docs/report/bibliography.bib",
                "--csl=ieee.csl",
                "-o",
                ".${/}${relativeFileDirname}${/}${fileBasenameNoExtension}.pdf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}